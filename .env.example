PTERODACTYL_URL=https://panel.example.com

# Application API key (ptla_*) — admin operations (optional)
PTERODACTYL_APP_KEY=ptla_your_application_key_here

# Client API key (ptlc_*) — user operations (optional)
PTERODACTYL_CLIENT_KEY=ptlc_your_client_key_here

PORT=3000

# Optional bearer token required on /mcp (HTTP transport).
# Unset = no authentication. Generate: openssl rand -hex 32
MCP_AUTH_TOKEN=
